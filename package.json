{
  "name": "shell-platform",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "壳平台 v2：一套壳 × N 产品形态（flavor）",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-driver-assets.mjs && pnpm --filter @app/shell dev",
    "doctor": "node scripts/doctor-dev.mjs",
    "dev:platform": "node scripts/prepare-driver-assets.mjs && pnpm --filter @app/shell dev -- --flavor=platform-demo",
    "dev:solo": "node scripts/prepare-driver-assets.mjs && pnpm --filter @app/shell dev -- --flavor=solo-demo",
    "dev:kiosk": "node scripts/prepare-driver-assets.mjs && pnpm --filter @app/shell dev -- --flavor=kiosk",
    "dev:diagnostics": "node scripts/prepare-driver-assets.mjs && pnpm --filter @app/shell dev:diagnostics",
    "build": "pnpm --filter @app/shell build",
    "build:win": "pnpm --filter @app/shell build:win",
    "build:mac": "pnpm --filter @app/shell build:mac",
    "build:linux": "pnpm --filter @app/shell build:linux",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "guard": "node scripts/guardrails/guard.mjs check",
    "guard:changed": "node scripts/guardrails/guard.mjs check --changed",
    "guard:baseline": "node scripts/guardrails/guard.mjs baseline",
    "guard:dead": "node scripts/guardrails/guard.mjs dead",
    "guard:list": "node scripts/guardrails/guard.mjs list",
    "guard:devices": "node scripts/guardrails/guard.mjs devices",
    "check:design": "node scripts/check-design-system.mjs check",
    "check:design:css": "node scripts/check-design-system.mjs css",
    "verify": "node scripts/verify.mjs",
    "typecheck": "pnpm -r typecheck",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "devDependencies": {
    "@shell/config": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi"
    ]
  }
}
