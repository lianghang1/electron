{
  "name": "shell-platform",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "壳平台 v2：一套壳 × N 产品形态（flavor）",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @app/shell dev",
    "build": "pnpm --filter @app/shell build",
    "build:win": "pnpm --filter @app/shell build:win",
    "build:mac": "pnpm --filter @app/shell build:mac",
    "build:linux": "pnpm --filter @app/shell build:linux",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --filter @shell/devices test",
    "typecheck": "pnpm -r typecheck",
    "postinstall": "node scripts/ensure-electron.mjs"
  },
  "devDependencies": {
    "@shell/config": "workspace:*",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "koffi"
    ]
  }
}