{
  "name": "electron-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "scripts": {
    "dev": "pnpm --filter @app/desktop dev",
    "build": "pnpm --filter @app/desktop build",
    "build:win": "pnpm --filter @app/desktop build:win",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gen:brand": "tsx resources/brand/generate.ts",
    "gen:app": "tsx scripts/generate-app.ts",
    "hotfix": "tsx scripts/pack-hotfix.ts",
    "test": "pnpm --filter @desktop/core test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@desktop/config": "workspace:*",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "ws": "^8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
