{
  "name": "@app/funeral",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "殡仪服务场所自助服务终端：业务缴费、发票开具、电子证照打印、班次查询",
  "author": {
    "name": "福瑞殡葬科技有限公司",
    "email": "dev@furui.example.com"
  },
  "homepage": "https://furui.example.com/fhkiosk",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "build": "pnpm run typecheck && electron-vite build",
    "build:win": "pnpm run build && electron-builder --win",
    "build:linux": "pnpm run build && electron-builder --linux",
    "icon": "tsx scripts/generate-icon.ts build",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/utils": "catalog:",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.5"
  },
  "devDependencies": {
    "@desktop/config": "workspace:*",
    "@desktop/core": "workspace:*",
    "@desktop/shared": "workspace:*",
    "@types/node": "catalog:",
    "@types/qrcode": "^1.5.5",
    "@vitejs/plugin-vue": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-router": "^4.5.0",
    "vue-tsc": "catalog:"
  }
}
