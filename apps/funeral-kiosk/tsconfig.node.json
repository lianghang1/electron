{
  "extends": "@desktop/config/tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "paths": {
      "@shared/*": ["./shared/*"],
      "@electron/*": ["./electron/*"]
    },
    "types": [
      "electron-vite/node"
    ]
  },
  "include": [
    "electron.vite.config.*",
    "electron/**/*",
    "shared/**/*.ts",
    "env.d.ts"
  ]
}
