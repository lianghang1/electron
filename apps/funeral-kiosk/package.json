{
  "name": "@app/funeral-kiosk",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "build": "pnpm run typecheck && electron-vite build",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "pnpm run build && electron-builder --mac",
    "build:linux": "pnpm run build && electron-builder --linux",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.company.funeral-kiosk",
    "productName": "FuneralKiosk",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dependencies": {
    "@alova/adapter-axios": "2.0.20",
    "@arco-design/web-vue": "2.58.0",
    "@desktop/utils": "workspace:*",
    "@electron-toolkit/utils": "catalog:",
    "@embedpdf/vue-pdf-viewer": "2.15.1",
    "@fun-design/http-alova-axios": "catalog:",
    "@vueuse/core": "catalog:",
    "alova": "3.5.5",
    "axios": "1.20.0",
    "crypto-js": "4.2.0",
    "pinia": "4.0.3",
    "pinia-plugin-persistedstate": "4.7.1",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@desktop/config": "workspace:*",
    "@desktop/core": "workspace:*",
    "@desktop/shared": "workspace:*",
    "@iconify/json": "2.2.541",
    "@iconify/utils": "3.1.7",
    "@types/node": "catalog:",
    "@unocss/preset-rem-to-px": "66.10.5",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "sass": "1.105.1",
    "typescript": "catalog:",
    "unocss": "66.10.5",
    "unplugin-auto-import": "21.1.0",
    "unplugin-vue-components": "32.1.0",
    "vite": "catalog:",
    "vue": "catalog:",
    "vue-tsc": "catalog:"
  }
}
