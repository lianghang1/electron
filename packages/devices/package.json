{
  "name": "@shell/devices",
  "type": "module",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "设备网关：kernel→adapters→vendors→host 四层（自 core 平移，逻辑未动）",
  "imports": {
    "#kernel/*": "./src/kernel/*.ts",
    "#runtime/*": "./src/runtime/*.ts",
    "#host/*": "./src/host/*.ts",
    "#platform": "./src/domains/platform/index.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shell/kernel": "workspace:*",
    "@shell/shared": "workspace:*",
    "electron-store": "catalog:",
    "koffi": "catalog:",
    "ws": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/ws": "catalog:",
    "typescript": "catalog:"
  }
}
