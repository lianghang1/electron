{
  "name": "@shell/bridge",
  "type": "module",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "渲染层唯一门面：preload contextBridge 单文件集中（可审计）+ 渲染层类型化客户端",
  "exports": {
    "./preload": {
      "types": "./dist/preload.d.ts",
      "default": "./dist/preload.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./jsapi-preload": {
      "types": "./dist/jsapi-preload.d.ts",
      "default": "./dist/jsapi-preload.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch"
  },
  "dependencies": {
    "@shell/shared": "workspace:*",
    "electron": "catalog:"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
